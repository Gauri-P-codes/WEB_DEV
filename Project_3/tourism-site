<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bootstrap Integration</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <style>
      body {
        background-color: #1a1a1a;
        margin: 0;
        padding: 0;
        line-height: 1.6;
        font-family:
          "Gill Sans", "Gill Sans MT", Calibri, "Trebuchet MS", sans-serif;
      }
      .caraousel {
        display: flex;
        justify-content: center;
        align-items: center;
      }
      #carouselExampleIndicators {
        width: 750px;
      }
      .caraousel img {
        height: 500px;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
        grid-template-rows: 800px,800px,800px;
        gap: 10px;
        margin-top: 15px;
        margin-bottom: 15px;
        padding-bottom: 20px;
      }
      .card1,.card2,.card3{
        background-color: #2c2c2c;
        color: rgba(255, 255, 255, 0.653);
        display:flex;
        flex-direction: column;
        align-items: center;
        margin:10px;
        padding-bottom: 20px;
        padding-top: 20px;
        border-radius: 10px;
    }
    .clickbait{
        width:300px;
        object-fit:contain;
        border-radius: 10px;
        margin-bottom: 5px;
    }
      h5 {
        text-align: center;
        padding:5px;
      }
      a {
        margin:0 auto;
        display: block;
        width: fit-content;
        padding: 5px;
        text-decoration: none;
        background-color: red;
        color: white;
        border-radius: 2px;
        border: 1px solid white;
      }
      u:hover{
        cursor: pointer;
      }
      @media (max-width:768px){
        .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
        grid-template-rows: 800px,800px,800px;
        gap: 10px;
        margin-top: 15px;
        margin-bottom: 15px;
        padding-bottom: 20px;
      }
        .caraousel{
            display: flex;
            justify-content: center;
            
        }
        #carouselExampleIndicators {
        width: 100vw;
        height:100vh;
      }
      .caraousel img {
        height: 100vh;
        width: 100%;
        object-fit: contain;
      }
    .cards{
        display:grid;
        gap: 10px;
        
    }
    .card1,.card2,.card3{
        display:flex;
        flex-direction: column;
        align-items: center;
        margin:10px;
        padding-bottom: 20px;
        border-radius: 5px;
    }
    .clickbait{
        object-fit:contain;
        border-radius: 5px;
    }
}

    </style>
  </head>
  <body>
    <div class="caraousel">
      <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
          <button
            type="button"
            data-bs-target="#carouselExampleIndicators"
            data-bs-slide-to="0"
            class="active"
            aria-current="true"
            aria-label="Slide 1"
          ></button>
          <button
            type="button"
            data-bs-target="#carouselExampleIndicators"
            data-bs-slide-to="1"
            aria-label="Slide 2"
          ></button>
          <button
            type="button"
            data-bs-target="#carouselExampleIndicators"
            data-bs-slide-to="2"
            aria-label="Slide 3"
          ></button>
        </div>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img
              src="https://images.pexels.com/photos/3532547/pexels-photo-3532547.jpeg"
              class="d-block w-100"
              alt="..."
            />
          </div>
          <div class="carousel-item">
            <img
              src="https://images.pexels.com/photos/3532551/pexels-photo-3532551.jpeg"
              class="d-block w-100"
              alt="..."
            />
          </div>
          <div class="carousel-item">
            <img
              src="https://images.pexels.com/photos/3532557/pexels-photo-3532557.jpeg"
              class="d-block w-100"
              alt="..."
            />
          </div>
        </div>
        <button
          class="carousel-control-prev"
          type="button"
          data-bs-target="#carouselExampleIndicators"
          data-bs-slide="prev"
          data-bs-touch="true"
        >
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button
          class="carousel-control-next"
          type="button"
          data-bs-target="#carouselExampleIndicators"
          data-bs-slide="next"
        >
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>

    <div class="cards">
      <div class="card1">
        <img
          class="clickbait"
          src="https://img.youtube.com/vi/Vg8pWujZ8WI/maxresdefault.jpg"
        />
        <h5>
          Japan’s Most Beautiful Temples & Shrines | Tradition vs Modern Culture
        </h5>
        <a target="_blank" href="https://www.youtube.com/watch?v=Vg8pWujZ8WI">
          WATCH NOW
        </a>
      </div>

      <div class="card2">
        <img
          class="clickbait"
          src="https://img.youtube.com/vi/CMxj69STwX0/maxresdefault.jpg"
        />
        <h5>
          Japan's Most Popular Foods Explained
        </h5>
        <a target="_blank" href="https://www.youtube.com/watch?v=CMxj69STwX0">
          WATCH NOW
        </a>
      </div>

      <div class="card3">
        <img
          class="clickbait"
          src="https://img.youtube.com/vi/IuTDuvYr7f0/maxresdefault.jpg"
        />
        <h5 style="padding: 10px;">
        How to Spend 14 Days in Japan - A Japan Travel Itinerary
        </h5>
        <a target="_blank" href="https://www.youtube.com/watch?v=IuTDuvYr7f0">
          WATCH NOW
        </a>
      </div>
    </div>

    <div
      class="copyright"
      style="
        margin-top: 10px;
        padding: 30px;
        background-color: #2c2c2c;
        color: rgba(255, 255, 255, 0.653);
        display: flex;
        justify-content: center;
      "
    >
      <h6>
        © XYZ Tours & Travels<br /><br />
        Find Us on : <u>Facebook</u> <u>Instagram</u> <u>X</u>  <u>Youtube</u>
      </h6>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>

